{
    "openapi": "3.0.3",
    "info": {
      "title": "Hapartment Backend API 1.0",
      "description": "We help users search for apartment easily and provide them with adequate information to help them make well-informed decisions.\n\nVisit website on  [https://hapartment.org](https://hapartment.org). \n\nHapartment is bringing agents with renters together by providing them with the simplest and most cost-effective route to renting properties online\"",
      "version": "1.0.11"
    },
    "servers": [
      {
        "url": "https://hapartment.onrender.com"
      }
    ],
    "tags": [
      {
        "name": "Hapartment",
        "description": "Easy way to find a perfect home",
        "externalDocs": {
          "description": "Visit our website",
          "url": "https://hapartment.org"
        }
      }
    ],
    "paths": {
      "/api/v1/register": {
        "post": {
          "tags": ["user"],
          "summary": "Create a user",
          "description": "Create a new user with user information.",
          "operationId": "createUser",
          "requestBody": {
            "description": "Login user object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Register"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Register"
                }
              },
              "application/x-www-form-urlencoded": {
                "schema": {
                  "$ref": "#/components/schemas/Register"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Success"
            },
            "400": {
              "description": "Not found"
            },
            "500": {
              "description": "Internal Server error"
            },
            "default": {
              "description": "Registration Successful",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Register"
                  }
                },
                "application/xml": {
                  "schema": {
                    "$ref": "#/components/schemas/Register"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/authenticate": {
        "post": {
          "tags": ["user"],
          "summary": "Authenticate a user",
          "description": "Authenticate a user with One time code",
          "operationId": "authenticateUser",
          "requestBody": {
            "description": "Authenticate user object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authenticate"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Authenticate"
                }
              },
              "application/x-www-form-urlencoded": {
                "schema": {
                  "$ref": "#/components/schemas/Authenticate"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Success Your Account has been activated"
            },
            "400": {
              "description": "Not found"
            },
            "500": {
              "description": "Internal Server error"
            },
            "default": {
              "description": "Your Account has been activated"
            }
          }
        }
      },
      "/api/v1/resend": {
        "post": {
          "tags": ["user"],
          "summary": "One time code",
          "description": "Resend One time code to the user",
          "operationId": "resendCode",
          "requestBody": {
            "description": "Resend One-time-code object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OneTimeCode"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/OneTimeCode"
                }
              },
              "application/x-www-form-urlencoded": {
                "schema": {
                  "$ref": "#/components/schemas/OneTimeCode"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Success"
            },
            "400": {
              "description": "Not found"
            },
            "500": {
              "description": "Internal Server error"
            },
            "default": {
              "description": "Code sent!, please check your mail to activate your account"
            }
          }
        }
      },
      "/api/v1/login": {
        "post": {
          "tags": ["user"],
          "summary": "Login a user",
          "description": "Login a user.",
          "operationId": "LoginUser",
          "requestBody": {
            "description": "Login user object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Login"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Login"
                }
              },
              "application/x-www-form-urlencoded": {
                "schema": {
                  "$ref": "#/components/schemas/Login"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Success"
            },
            "400": {
              "description": "Not found"
            },
            "500": {
              "description": "Internal Server error"
            },
            "default": {
              "description": "Login Successful",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Login"
                  }
                },
                "application/xml": {
                  "schema": {
                    "$ref": "#/components/schemas/Login"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/forgotpassword": {
        "post": {
          "tags": ["user"],
          "summary": "Retrieve user password",
          "description": "Retrieve user password",
          "operationId": "ForgotPassword",
          "requestBody": {
            "description": "Retrieve user password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForgotPassword"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ForgotPassword"
                }
              },
              "application/x-www-form-urlencoded": {
                "schema": {
                  "$ref": "#/components/schemas/ForgotPassword"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Success"
            },
            "400": {
              "description": "Not found"
            },
            "500": {
              "description": "Internal Server error"
            },
            "default": {
              "description": "Check your email to continue",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ForgotPassword"
                  }
                },
                "application/xml": {
                  "schema": {
                    "$ref": "#/components/schemas/ForgotPassword"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/resetpassword": {
        "post": {
          "tags": ["user"],
          "summary": "Reset user password",
          "description": "Reset user password",
          "operationId": "ResetPassword",
          "requestBody": {
            "description": "Reset user password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetPassword"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ResetPassword"
                }
              },
              "application/x-www-form-urlencoded": {
                "schema": {
                  "$ref": "#/components/schemas/ResetPassword"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Success"
            },
            "400": {
              "description": "Not found"
            },
            "500": {
              "description": "Internal Server error"
            },
            "default": {
              "description": "Password changed successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ResetPassword"
                  }
                },
                "application/xml": {
                  "schema": {
                    "$ref": "#/components/schemas/ResetPassword"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/user": {
        "get": {
          "tags": ["user"],
          "summary": "Fetch Logged in user",
          "description": "Fetch logged in user",
          "operationId": "loggedinUser",
          "responses": {
            "200": {
              "description": "Success"
            },
            "400": {
              "description": "Not authorized"
            },
            "500": {
              "description": "Internal Server error"
            },
            "default": {
              "description": "Success",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/User"
                  }
                },
                "application/xml": {
                  "schema": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "security": [
            {
              "auth": []
            }
          ]
        }
      }
    },
    "components": {
      "schemas": {
        "Register": {
          "type": "object",
          "properties": {
            "fullname": {
              "type": "string",
              "example": "Bright Layo"
            },
            "username": {
              "type": "string",
              "example": "brightlayo"
            },
            "email": {
              "type": "string",
              "example": "brightlayo11@gmail.com"
            },
            "password": {
              "type": "string",
              "example": "brightlayo"
            },
            "userType": {
              "type": "string",
              "example": "agent"
            }
          },
          "xml": {
            "name": "users"
          }
        },
        "Login": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "example": "brightlayo11@gmail.com"
            },
            "password": {
              "type": "string",
              "example": "brightlayo"
            }
          },
          "xml": {
            "name": "users"
          }
        },
        "Authenticate": {
          "type": "object",
          "properties": {
            "activation_token": {
              "type": "string",
              "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ZPgToJLPzktyWx6d3ysGAMyDJIv_59gp5Ev9TUXhXgg"
            },
            "auth_code": {
              "type": "string",
              "example": 5087
            }
          },
          "xml": {
            "name": "users"
          }
        },
        "OneTimeCode": {
          "type": "object",
          "properties": {
            "activationtoken": {
              "type": "string",
              "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ZPgToJLPzktyWx6d3ysGAMyDJIv_59gp5Ev9TUXhXgg"
            }
          },
          "xml": {
            "name": "users"
          }
        },
        "ForgotPassword": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "example": "brightlayo11@gmail.com"
            }
          },
          "xml": {
            "name": "users"
          }
        },
        "ResetPassword": {
          "type": "object",
          "properties": {
            "activation_token": {
              "type": "string",
              "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ZPgToJLPzktyWx6d3ysGAMyDJIv_59gp5Ev9TUXhXgg"
            },
            "auth_code": {
              "type": "string",
              "example": 23456788
            },
            "password": {
              "type": "string",
              "example": "****"
            }
          },
          "xml": {
            "name": "users"
          }
        },
        "User": {
          "type": "object",
          "properties": {
            "_id": {
              "type": "string",
              "example": "639651bb01a1a34399696c87"
            },
            "fullname": {
              "type": "string",
              "example": "Bright Layo"
            },
            "username": {
              "type": "string",
              "example": "brightlayo"
            },
            "email": {
              "type": "string",
              "example": "brightlayo11@gmail.com"
            },
            "userType": {
              "type": "string",
              "example": "agent"
            },
            "image": {
              "type": "string",
              "example": "https://res.cloudinary.com/hapartment/image/upload/v1670933143/zwamfb7kkvvvvw4dsotl.jpg"
            },
            "verification": {
              "type": "array",
              "items": {
                "properties": {
                  "identity_name": {
                    "type": "string",
                    "example": "Ayodeji Oladimeji"
                  },
                  "identity_mobile": {
                    "type": "string",
                    "example": 8023232323
                  },
                  "identity_selfie": {
                    "type": "string",
                    "example": "https://res.cloudinary.com/hapartment/image/upload/v1670812427/jqza0qeugytcvjsxfmrf.jpg"
                  },
                  "identity_document": {
                    "type": "string",
                    "example": "https://res.cloudinary.com/hapartment/image/upload/v1670812427/jqza0qeugytcvjsxfmrf.jpg"
                  },
                  "document_type": {
                    "type": "string",
                    "example": "National ID Card"
                  },
                  "isVerified": {
                    "type": "string",
                    "example": "true"
                  },
                  "_id": {
                    "type": "string",
                    "example": "6396930e6dcf0ce3972f282"
                  }
                }
              }
            }
          }
        }
      },
      "securitySchemes": {
        "auth": {
          "type": "apiKey",
          "name": "Authorization",
          "in": "header",
          "description": "Standard Authorization header using the Authorization scheme  Example \\\"Authorization {access_token}\\\"\""
        }
      }
    }
  }